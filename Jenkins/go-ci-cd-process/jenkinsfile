pipeline {
    agent any
    tools {
        // same name of installation should be present in Tools here it is go so make sure go has installation with name go-1.23.4
        go 'go-1.23.4'
    }

    environment {
        GO111MODULE='on'
    }

    stages {
        stage ('Clone') {
            steps {
                git 'https://github.com/kodekloudhub/go-webapp-sample.git'
                sh 'go test ./...'
            }
        }
        // We need Docker and Docker pipeline plugin install to build image
        stage ('Build') {
            steps {
                script {
                    app = docker.build("harshal2508/go-webapp-sample")
                }
            }
        }

        stage ('Deploy') {
            steps {
                sh "docker run -p 8090:8000 -d adminturneddevops/go-webapp-sample"
            }
        }
    }
}